# Netlify headers for tchuekam.com

# Release manifests - must revalidate immediately so app update checks are fresh
/downloads/magida/latest.json
  Cache-Control: no-cache, no-store, must-revalidate
  Access-Control-Allow-Origin: *
  Content-Type: application/json

# Versioned Android APK binaries - permanent cache with direct download disposition
/downloads/magida/MAGIDA-*.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

# Stable latest Android APK alias - 1 hour cache
/downloads/magida/MAGIDA-latest.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="MAGIDA-latest.apk"
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600, must-revalidate

# OTA Web Bundles
/downloads/magida/web/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
